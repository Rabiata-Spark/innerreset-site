  "semantic": [
    {
      "id": "typography",
      "implementation": "Use semantic h1/h2/h3 and paragraphs; @font-face Cinzel Medium for display headings and existing Inter for body. Keep copy selectable and responsive.",
      "notes": "No raster lettering.",
      "qa_status": "accepted"
    },
    {
      "id": "controls",
      "implementation": "Use native links, buttons and form controls with visible focus states; CSS places decorative paint textures behind live text and owns sizing and hit areas.",
      "notes": "No baked buttons or labels.",
      "qa_status": "accepted"
    },
    {
      "id": "composition",
      "implementation": "CSS grid places approved character img elements beside live copy; use object-fit: contain and intrinsic aspect ratios. Responsive layout stacks columns. CSS owns page color, spacing and paint background placement.",
      "notes": "Do not crop silhouettes or stretch transparent textures.",
      "qa_status": "accepted"
    }
  ],
